---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/dm-sans/opsz.css';
import '../styles/global.css';
import '../styles/pages.css';
import { HOLDING } from '../lib/site';

interface Props {
  /** The browser tab and share title. */
  title: string;
  /** One sentence for search results and link previews. */
  description: string;
  /** Share image path from /og, e.g. "/og/slick-bets.png". Defaults to the homepage image. */
  image?: string;
  /** "article" for project pages, "website" for everything else. */
  type?: 'website' | 'article';
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
  /** Extra class for <main>, so a page can set its own spacing. */
  mainClass?: string;
}

const { title, description, image = '/og/home.png', type = 'website', noindex = false, mainClass } = Astro.props;

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en" class:list={{ holding: HOLDING }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Spencer Solomon" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#F6D9C8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="mark" href="/" aria-label="Spencer Solomon, home">
          <img class="mark-s" src="/favicon.svg" alt="" width="38" height="38" />
          <span class="mark-name">Spencer Solomon</span>
        </a>
        {!HOLDING && (
          <nav class="nav" aria-label="Main">
            {links.map(({ href, label }) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
            <a class="cta" href="/#contact">Contact</a>
          </nav>
        )}
      </div>
    </header>

    <main id="main" class={mainClass}>
      <slot />
    </main>

    <footer class="foot" id="contact">
      <div class="wrap foot-in">
        <p>Spencer Solomon, Springfield, MO</p>
        {!HOLDING && (
          <nav aria-label="Contact">
            <a href="mailto:spencerwsolomon@gmail.com">spencerwsolomon@gmail.com</a>
            <ul class="socials">
              <li><a href="https://www.linkedin.com/in/spencerwsolomon/" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 11v5"/><path d="M8 8v.01"/><path d="M12 16v-5"/><path d="M16 16v-3a2 2 0 1 0 -4 0"/><path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10"/></svg></a></li>
              <li><a href="https://github.com/slickbets" aria-label="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"/></svg></a></li>
              <li><a href="https://x.com/slick_sgf" aria-label="X"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4l11.733 16h4.267l-11.733 -16l-4.267 0"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg></a></li>
            </ul>
          </nav>
        )}
      </div>
    </footer>

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>

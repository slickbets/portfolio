---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/dm-sans/opsz.css';
import '../styles/global.css';
import '../styles/pages.css';
import { HOLDING } from '../lib/site';

interface Props {
  /** The browser tab and share title. */
  title: string;
  /** One sentence for search results and link previews. */
  description: string;
  /** Share image path from /og, e.g. "/og/slick-bets.png". Defaults to the homepage image. */
  image?: string;
  /** "article" for project pages, "website" for everything else. */
  type?: 'website' | 'article';
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
  /** Extra class for <main>, so a page can set its own spacing. */
  mainClass?: string;
}

const { title, description, image = '/og/home.png', type = 'website', noindex = false, mainClass } = Astro.props;

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en" class:list={{ holding: HOLDING }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Spencer Solomon" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#F6D9C8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="mark" href="/" aria-label="Spencer Solomon, home">
          <img class="mark-s" src="/favicon.svg" alt="" width="38" height="38" />
          <span class="mark-name">Spencer Solomon</span>
        </a>
        {!HOLDING && (
          <nav class="nav" aria-label="Main">
            {links.map(({ href, label }) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
            <a class="cta" href="/#contact">Contact</a>
          </nav>
        )}
      </div>
    </header>

    <main id="main" class={mainClass}>
      <slot />
    </main>

    <footer class="foot" id="contact">
      <div class="wrap foot-in">
        <p>Spencer Solomon, Springfield, MO</p>
        {!HOLDING && (
          <nav aria-label="Contact">
            <a href="mailto:spencerwsolomon@gmail.com">spencerwsolomon@gmail.com</a>
            <ul class="socials">
              <li><a href="https://www.linkedin.com/in/spencerwsolomon/" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg></a></li>
              <li><a href="https://github.com/slickbets" aria-label="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.4-1.34-1.77-1.34-1.77-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .3z"/></svg></a></li>
              <li><a href="https://x.com/slick_sgf" aria-label="X"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.64 7.58H.48l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93zm-1.29 19.5h2.04L6.48 3.24H4.3l13.31 17.41z"/></svg></a></li>
            </ul>
          </nav>
        )}
      </div>
    </footer>

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>

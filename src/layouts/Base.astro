---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/dm-sans/opsz.css';
import '../styles/global.css';
import '../styles/pages.css';
import { HOLDING } from '../lib/site';

interface Props {
  /** The browser tab and share title. */
  title: string;
  /** One sentence for search results and link previews. */
  description: string;
  /** Share image path from /og, e.g. "/og/slick-bets.png". Defaults to the homepage image. */
  image?: string;
  /** "article" for project pages, "website" for everything else. */
  type?: 'website' | 'article';
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
  /** Extra class for <main>, so a page can set its own spacing. */
  mainClass?: string;
}

const { title, description, image = '/og/home.png', type = 'website', noindex = false, mainClass } = Astro.props;

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en" class:list={{ holding: HOLDING }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Spencer Solomon" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#F6D9C8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="mark" href="/" aria-label="Spencer Solomon, home">
          <img class="mark-s" src="/favicon.svg" alt="" width="38" height="38" />
          <span class="mark-name">Spencer Solomon</span>
        </a>
        {!HOLDING && (
          <nav class="nav" aria-label="Main">
            {links.map(({ href, label }) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
            <a class="cta" href="/#contact">Contact</a>
          </nav>
        )}
      </div>
    </header>

    <main id="main" class={mainClass}>
      <slot />
    </main>

    <footer class="foot" id="contact">
      <div class="wrap foot-in">
        <p>Spencer Solomon, Springfield, MO</p>
        {!HOLDING && (
          <nav aria-label="Contact">
            <a href="mailto:spencerwsolomon@gmail.com">spencerwsolomon@gmail.com</a>
            <ul class="socials">
              <li><a href="https://www.linkedin.com/in/spencerwsolomon/" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a></li>
              <li><a href="https://github.com/slickbets" aria-label="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg></a></li>
              <li><a href="https://x.com/slick_sgf" aria-label="X"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/></svg></a></li>
            </ul>
          </nav>
        )}
      </div>
    </footer>

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>

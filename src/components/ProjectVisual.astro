---
// A project's picture, built as HTML from the values in its screenshots (a diagram for the confidential
// work). "card" is the small version on the homepage and Work page, "lead" is the big one on the case study.
// A new project with a cover image falls back to that image in a browser frame.
import { Image } from 'astro:assets';
import Flow from './visuals/Flow.astro';
import Picks from './visuals/Picks.astro';
import Board from './visuals/Board.astro';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  variant?: 'card' | 'lead';
}

const { project, variant = 'card' } = Astro.props;
const lead = variant === 'lead';
const { cover, coverAlt } = project.data;
const known = new Set(['support-content-hub', 'slick-bets', 'auction-draft']);
if (!known.has(project.id) && !cover) {
  throw new Error(`Project "${project.id}" needs a cover image, or a visual in ProjectVisual.astro.`);
}
---

{project.id === 'support-content-hub' ? (
  <Flow note={lead} />
) : project.id === 'slick-bets' ? (
  <Picks wide={lead} />
) : project.id === 'auction-draft' ? (
  <Board full={lead} />
) : (
  <div class="browser">
    <span class="browser-bar" aria-hidden="true"><i></i><i></i><i></i></span>
    <Image src={cover!} alt={coverAlt ?? ''} widths={[640, 1100]} sizes={lead ? '860px' : '(min-width: 900px) 540px, 90vw'} />
  </div>
)}

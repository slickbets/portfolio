---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import Arrow from './Arrow.astro';
import { orderedProjects } from '../lib/projects';
import me from '../assets/about/me.jpg';
import bridge from '../assets/about/golden-gate.jpg';
import columns from '../assets/about/athens.jpg';

const featured = (await orderedProjects()).filter(({ project }) => project.data.featured !== undefined);

// The tools line in About: the tools used across the projects, most-used first.
const tools = ['AI coding tools', 'React', 'TypeScript', 'Node.js', 'Python', 'Postgres'];

// Tells search engines who this site is about, so a search for the name can show a profile.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  // Same @id as the Person on /about, so search engines treat both blocks as one person.
  '@id': 'https://spencerwsolomon.com/#person',
  name: 'Spencer Solomon',
  url: 'https://spencerwsolomon.com/',
  jobTitle: 'Technical Program Manager',
  worksFor: { '@type': 'Organization', name: 'SentinelOne' },
  email: 'mailto:spencerwsolomon@gmail.com',
  address: { '@type': 'PostalAddress', addressCountry: 'US' },
  sameAs: ['https://www.linkedin.com/in/spencerwsolomon/', 'https://github.com/slickbets'],
};
---

<Base title="Spencer Solomon | The PM who builds" description="Technical program manager in cyber and fintech who builds his own tools. Case studies on a help desk migration, an NBA model and a live fantasy football draft tool.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />

  <!-- Hero: the name as the headline, then the subline. Then Spencer's photo, which the work sheet rises over. -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <h1 class="headline hero-name rv" id="hero-title">Spencer Solomon</h1>
      <div class="hero-foot">
        <p class="lede lede-id rv" style="--d:180ms">Technical Program Manager. Nine years leading technical programs in cyber, fintech and banking.</p>
        <a class="btn btn-ink rv" style="--d:240ms" href="#work">See my work
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v13M4 10l6 6 6-6"></path></svg>
        </a>
      </div>
    </div>
    <figure class="hero-photo wrap rv" style="--d:200ms">
      <Image src={me} alt="Spencer Solomon in a navy cap, glasses and a red plaid jacket, standing in front of a large orange maple tree in autumn." widths={[900, 1400, 2000]} sizes="(min-width: 1300px) 1240px, 100vw" loading="eager" />
    </figure>
  </section>

  <!-- Work: a lighter sheet that rises over the peach field, with no hard rule between them. -->
  <section class="work sheet" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="sec-head rv">
        <p class="kicker"><span class="dot" aria-hidden="true"></span>Featured work</p>
        <h2 id="work-title">Three builds, three different endings.</h2>
      </div>
      {featured.map(({ project, color }, i) => <ProjectCard project={project} color={color} flip={i % 2 === 1} />)}
    </div>
  </section>

  <!-- About: back on the peach field. Photos share one clean crop shape. -->
  <section class="about" id="about" aria-labelledby="about-title">
    <div class="wrap about-in">
      <div class="about-l">
        <div class="about-sticky">
          <p class="kicker rv"><span class="dot" aria-hidden="true"></span>About</p>
          <h2 class="rv" id="about-title">I used to coordinate the builders. Now I build too.</h2>
          <div class="chapter-lead rv">
            <p class="ch-label"><b>01</b>The day job</p>
            <p>I'm a Technical Program Manager in cybersecurity, based in the Midwest. I've spent nine years in cyber, fintech and banking getting complicated technical work finished: migrations, rollouts and projects that touch a dozen teams.</p>
          </div>
          <div class="tools rv">
            <p class="ch-label">Built with</p>
            <ul class="tags" aria-label="Tools across my projects">{tools.map((tool) => <li>{tool}</li>)}</ul>
          </div>
          <a class="more rv" href="/about">More about me <Arrow /></a>
        </div>
      </div>
      <div class="chapters">
        <figure class="chapter rv">
          <div class="photo">
            <Image src={bridge} alt="The Golden Gate Bridge seen across the water from a hillside path, under a clear blue sky." widths={[480, 800]} sizes="(min-width: 900px) 380px, 90vw" />
            <span class="photo-tag"><b>02</b>The switch</span>
          </div>
          <figcaption><p>In early 2026 I started building the tools myself with AI instead of only coordinating the people who build them.</p></figcaption>
        </figure>
        <figure class="chapter rv" style="--d:100ms">
          <div class="photo">
            <Image src={columns} alt="A long row of white marble columns beside a stone walkway, under a blue sky with streaky clouds." widths={[480, 800]} sizes="(min-width: 900px) 380px, 90vw" style="object-position: 50% 60%" />
            <span class="photo-tag"><b>03</b>Off the clock</span>
          </div>
          <figcaption><p>Outside of work, I'm an avid Chiefs fan. I play golf, travel with my wife, and take care of our two dogs, Zoey and Traeger.</p></figcaption>
        </figure>
      </div>
    </div>
  </section>

</Base>

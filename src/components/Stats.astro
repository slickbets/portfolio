---
// A row of headline numbers. Values come from the project's `stats` frontmatter, so they only
// ever repeat facts already in the case study.
interface Props {
  stats: { value: string; label: string }[];
  compact?: boolean;
}
const { stats, compact = false } = Astro.props;
---

<dl class:list={['stats', { compact }]}>
  {stats.map(({ value, label }) => (
    <div><dt>{label}</dt><dd>{value}</dd></div>
  ))}
</dl>

<style>
  .stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    border-radius: 22px;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    overflow: hidden;
  }
  .stats div { background: var(--bg); padding: 16px 18px; display: grid; grid-template-rows: auto 1fr; align-content: start; gap: 4px; }
  dd { grid-row: 1; }
  dt { grid-row: 2; }
  dd { margin: 0; font: 900 var(--t40)/1 var(--disp); letter-spacing: 0; color: var(--accent); }
  dt { font: 400 var(--t14)/1.4 var(--sans); color: var(--muted-strong); text-wrap: pretty; }
  .compact { border-radius: 14px; }
  .compact div { padding: 12px 14px; }
  .compact dd { font: 900 var(--t28)/1 var(--disp); letter-spacing: 0; }
  .compact dt { font-size: var(--t14); text-wrap: balance; }
</style>

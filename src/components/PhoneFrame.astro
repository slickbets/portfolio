---
// A screenshot inside a dark phone bezel. The image is cropped to a 9:17 phone screen.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Which part of the screenshot shows through the crop, as a CSS object-position. */
  position?: string;
  /** How wide the phone shows on desktop, in CSS pixels. Used to pick image sizes. */
  width?: number;
  priority?: boolean;
  class?: string;
}

const { src, alt, position = 'center top', width = 240, priority = false, class: className } = Astro.props;

// The crop fills a 9:17 screen, so a wide screenshot is drawn much wider than the phone itself.
const cover = Math.max(1, (17 / 9) * (src.width / src.height));
const shown = Math.round(width * cover);
const sizes = `(max-width: 767px) ${Math.round(60 * cover)}vw, ${shown}px`;
const widths = [...new Set([shown, shown * 2].map((w) => Math.min(w, src.width)))];
---

<div class:list={['phone', className]}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    style={`object-position: ${position}`}
  />
</div>

<style>
  .phone {
    border-radius: 34px;
    background: var(--frame);
    padding: 8px;
    box-shadow: 0 30px 60px -28px rgb(var(--shadow) / .5);
  }
  img { display: block; width: 100%; height: auto; border-radius: 27px; aspect-ratio: 9 / 17; object-fit: cover; }
</style>

---
// A screenshot inside a light browser window. Every desktop screenshot on the site goes in one of these.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** How wide the frame shows on desktop, in CSS pixels. Used to pick image sizes. */
  width?: number;
  /** Load right away instead of lazily. Use for the frame in the first screen of a page. */
  priority?: boolean;
  class?: string;
}

const { src, alt, width = 640, priority = false, class: className } = Astro.props;

// The crop fills a 16:10 window, so a wider screenshot is drawn wider than the frame.
const cover = Math.max(1, src.width / src.height / (16 / 10));
const shown = Math.round(width * cover);
const sizes = `(max-width: 767px) ${Math.round(100 * cover)}vw, ${shown}px`;
const widths = [...new Set([Math.round(shown / 2), shown, shown * 2].map((w) => Math.min(w, src.width)))];
---

<div class:list={['browser', className]}>
  <div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
</div>

<style>
  .browser {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--bg);
    box-shadow: 0 30px 60px -32px rgb(var(--shadow) / .35);
  }
  .bar { height: 28px; background: var(--chrome); display: flex; gap: 6px; align-items: center; padding-inline: 12px; }
  .bar i { width: 9px; height: 9px; border-radius: 50%; background: var(--dot); display: block; }
  img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
</style>

---
import Base from '../layouts/Base.astro';
import Headline from './Headline.astro';

const linkedin = 'https://www.linkedin.com/in/spencerwsolomon/';
const email = 'spencerwsolomon@gmail.com';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://spencerwsolomon.com/#person',
  name: 'Spencer Solomon',
  url: 'https://spencerwsolomon.com/',
  jobTitle: 'Technical Program Manager',
  worksFor: { '@type': 'Organization', name: 'SentinelOne' },
  email: 'mailto:spencerwsolomon@gmail.com',
  address: { '@type': 'PostalAddress', addressCountry: 'US' },
  sameAs: [linkedin, 'https://github.com/slickbets'],
};
---

<Base
  title="Spencer Solomon"
  description="Spencer Solomon, a PM who builds. From the roadmap to the repo."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />

  <section class="hero holding-hero" aria-labelledby="hero-title">
    <div class="wrap">
      <Headline />
      <div class="hero-foot">
        <div class="email-row rv" style="--d:180ms">
          <a class="email" href={`mailto:${email}`}>{email}</a>
          <button class="btn btn-soft btn-sm" type="button" data-copy={email}>Copy email</button>
        </div>
        <a class="btn btn-ink rv" style="--d:240ms" href={linkedin}>LinkedIn</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .holding-hero { padding-bottom: clamp(72px, 12vw, 176px); }
  .holding-hero .email-row { margin-bottom: 0; }
</style>

---
// The project status label, e.g. "Shipped". The list matches the status field in CLAUDE.md.
interface Props {
  status: 'Live' | 'Shipped' | 'Prototype' | 'Concept' | 'Retired';
}

const { status } = Astro.props;
---

<span class="pill">{status}</span>

<style>
  .pill {
    display: inline-block;
    padding: 6px 11px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    color: var(--fg);
    background: var(--bg);
    font: 500 13px/1 var(--mono);
  }
</style>

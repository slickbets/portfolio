---
// The project status label, e.g. "Shipped". The list matches the status field in CLAUDE.md.
interface Props {
  status: 'Live' | 'Shipped' | 'Prototype' | 'Concept' | 'Retired';
}

const { status } = Astro.props;
---

<span class="pill">{status}</span>

<style>
  /* A dark pill with a glowing accent dot, like the wheel cards' status. */
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px 8px 10px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--cream);
    box-shadow: inset 0 0 0 1px var(--rule);
    font: 600 13px/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: .1em;
  }
  .pill::before { content: ""; flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
</style>

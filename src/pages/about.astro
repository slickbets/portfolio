---
// Words from docs/core-copy.md (approved 2026-10-02), with the SentinelOne start added. Date ranges use "to" per the copy rules.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import me from '../assets/about/me.jpg';
import bridge from '../assets/about/golden-gate.jpg';
import columns from '../assets/about/athens.jpg';

// Tells search engines who this page is about. Facts only from this site.
const profile = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "url": "https://spencerwsolomon.com/about",
  "mainEntity": {
    "@type": "Person",
    "@id": "https://spencerwsolomon.com/#person",
    "name": "Spencer Solomon",
    "url": "https://spencerwsolomon.com/",
    "jobTitle": "Staff Technical Project Manager",
    "worksFor": {
      "@type": "Organization",
      "name": "SentinelOne"
    },
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "US"
    },
    "sameAs": [
      "https://www.linkedin.com/in/spencerwsolomon/",
      "https://github.com/slickbets"
    ],
    "hasCredential": {
      "@type": "EducationalOccupationalCredential",
      "name": "Project Management Professional (PMP)",
      "credentialCategory": "certification",
      "dateCreated": "2023"
    },
    "alumniOf": [
      {
        "@type": "EducationalOrganization",
        "name": "Ozarks Technical Community College"
      },
      {
        "@type": "OrganizationRole",
        "alumniOf": {
          "@type": "Organization",
          "name": "Block"
        },
        "roleName": "Senior Technical Project Manager",
        "startDate": "2024",
        "endDate": "2026"
      },
      {
        "@type": "OrganizationRole",
        "alumniOf": {
          "@type": "Organization",
          "name": "Jack Henry & Associates"
        },
        "roleName": "Advisory Technical Project Manager",
        "startDate": "2021",
        "endDate": "2024"
      },
      {
        "@type": "OrganizationRole",
        "alumniOf": {
          "@type": "Organization",
          "name": "Pondurance"
        },
        "roleName": "Lead Project Manager, Implementations",
        "startDate": "2020",
        "endDate": "2021"
      },
      {
        "@type": "OrganizationRole",
        "alumniOf": {
          "@type": "Organization",
          "name": "Jack Henry & Associates"
        },
        "roleName": "Technical Project Manager",
        "startDate": "2017",
        "endDate": "2020"
      }
    ],
    "knowsAbout": [
      "Claude Code",
      "Technical program management",
      "AI-assisted product building"
    ]
  }
};

// The Experience list. The wording is the same as before: company, role and years.
const roles = [
  { company: 'SentinelOne', role: 'Staff Technical Project Manager', dates: '2026 to now' },
  { company: 'Block (Square, Cash App, Afterpay)', role: 'Senior Technical Project Manager', dates: '2024 to 2026' },
  { company: 'Jack Henry & Associates', role: 'Advisory Technical Project Manager', dates: '2021 to 2024' },
  { company: 'Pondurance', role: 'Lead Project Manager, Implementations', dates: '2020 to 2021' },
  { company: 'Jack Henry & Associates', role: 'Technical Project Manager', dates: '2017 to 2020' },
];
---

<Base title="About | Spencer Solomon" description="Spencer Solomon's background, experience and contact details." mainClass="about-main">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(profile)} />
  <section class="page-head about-head wrap" aria-labelledby="about-title">
    <div class="about-grid">
      <div class="bio">
        <p class="kicker rv"><span class="dot" aria-hidden="true"></span>About</p>
        <h1 class="rv" id="about-title">About</h1>
        <p class="bio-lede rv" style="--d:60ms">I'm a Staff Technical Project Manager at SentinelOne, based in the Midwest. I joined SentinelOne in May 2026. Before that I spent nine years at Block, Jack Henry and Pondurance. My job has always been getting complicated technical work across the finish line: migrations, rollouts and projects that touch a dozen teams.</p>
        <p class="rv">In early 2026 that changed. With AI coding tools, mainly Claude Code, I started building the tools myself instead of only coordinating the people who build them. I'm not a traditional software engineer, and I don't pretend to be. What I'm good at is knowing what to build, directing the AI to build it, checking the work, and deciding when it's done or when to walk away.</p>
        <p class="rv">That shows up in the work here:</p>
        <ul class="bio-list rv">
          <li>At Block I built a knowledge base for support agents that went to production, plus the tools that kept a large content migration on track. <a class="inline" href="/work/support-content-hub">Read the case study</a></li>
          <li>On my own time I built an NBA prediction model that ran live for a season, and a real-time auction draft room for my fantasy football league. <a class="inline" href="/work">See all work</a></li>
        </ul>
        <p class="rv">I'm looking for product, technical program or builder roles where I can do both: figure out the right thing to build, and build it. I'm especially interested in fintech, sports tech and internal tools.</p>
        <p class="rv">Outside of work, I'm an avid Chiefs fan. I play golf, travel with my wife, and take care of our two dogs, Zoey and Traeger.</p>
      </div>
      <figure class="about-me rv" style="--d:120ms">
        <Image src={me} alt="Spencer Solomon smiling in a gray suit, blue tie and ball cap, lit by a camera flash against a dark night sky." widths={[640, 1000, 1640]} sizes="(min-width: 900px) 520px, 100vw" loading="eager" />
      </figure>
    </div>
    <div class="about-pair">
      <div class="photo rv"><Image src={bridge} alt="The Golden Gate Bridge seen across the water from a hillside path, under a clear blue sky." widths={[480, 960]} sizes="(min-width: 900px) 600px, 100vw" /></div>
      <div class="photo rv" style="--d:100ms"><Image src={columns} alt="A long row of white marble columns beside a stone walkway, under a blue sky with streaky clouds." widths={[480, 768]} sizes="(min-width: 900px) 600px, 100vw" style="object-position: 50% 60%" /></div>
    </div>
  </section>
  <section class="sheet exp" id="experience" aria-labelledby="exp-title">
    <div class="wrap exp-in">
      <div class="exp-l">
        <p class="kicker rv"><span class="dot" aria-hidden="true"></span>Experience</p>
        <h2 class="rv" id="exp-title">Experience</h2>
        <p class="cert rv"><span class="cert-dot" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4.5 10.5l3.5 3.5 7.5-8"></path></svg></span>PMP certified (2023).</p>
      </div>
      <ul class="roles">
        {roles.map(({ company, role, dates }) => (
          <li class="role rv"><span class="co">{company}</span><span class="role-t"><strong>{role}</strong><span class="dates">{dates}</span></span></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

---
// Words from docs/core-copy.md (approved 2026-10-02). Date ranges use "to" per the copy rules.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import me from '../assets/about/me.jpg';
import bridge from '../assets/about/golden-gate.jpg';
import columns from '../assets/about/athens.jpg';

// Tells search engines who this page is about. Facts only from this site.
const profile = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "url": "https://spencerwsolomon.com/about",
  "mainEntity": {
    "@type": "Person",
    "@id": "https://spencerwsolomon.com/#person",
    "name": "Spencer Solomon",
    "url": "https://spencerwsolomon.com/",
    "jobTitle": "Staff Technical Project Manager",
    "worksFor": {
      "@type": "Organization",
      "name": "SentinelOne"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Springfield",
      "addressRegion": "MO",
      "addressCountry": "US"
    },
    "sameAs": [
      "https://www.linkedin.com/in/spencerwsolomon/",
      "https://github.com/slickbets"
    ],
    "hasCredential": {
      "@type": "EducationalOccupationalCredential",
      "name": "Project Management Professional (PMP)",
      "credentialCategory": "certification",
      "dateCreated": "2023"
    },
    "alumniOf": [
      {
        "@type": "EducationalOrganization",
        "name": "Ozarks Technical Community College"
      },
      {
        "@type": "OrganizationRole",
        "alumniOf": {
          "@type": "Organization",
          "name": "Block"
        },
        "roleName": "Senior Technical Project Manager",
        "startDate": "2024",
        "endDate": "2026"
      },
      {
        "@type": "OrganizationRole",
        "alumniOf": {
          "@type": "Organization",
          "name": "Jack Henry & Associates"
        },
        "roleName": "Advisory Technical Project Manager",
        "startDate": "2021",
        "endDate": "2024"
      },
      {
        "@type": "OrganizationRole",
        "alumniOf": {
          "@type": "Organization",
          "name": "Pondurance"
        },
        "roleName": "Lead Project Manager, Implementations",
        "startDate": "2020",
        "endDate": "2021"
      },
      {
        "@type": "OrganizationRole",
        "alumniOf": {
          "@type": "Organization",
          "name": "Jack Henry & Associates"
        },
        "roleName": "Technical Project Manager",
        "startDate": "2017",
        "endDate": "2020"
      }
    ],
    "knowsAbout": [
      "Claude Code",
      "Technical program management",
      "AI-assisted product building"
    ]
  }
};

// The Experience list. The wording is the same as before: company, role and years.
const roles = [
  { company: 'SentinelOne', role: 'Staff Technical Project Manager', dates: '2026 to now' },
  { company: 'Block (Square, Cash App, Afterpay)', role: 'Senior Technical Project Manager', dates: '2024 to 2026' },
  { company: 'Jack Henry & Associates', role: 'Advisory Technical Project Manager', dates: '2021 to 2024' },
  { company: 'Pondurance', role: 'Lead Project Manager, Implementations', dates: '2020 to 2021' },
  { company: 'Jack Henry & Associates', role: 'Technical Project Manager', dates: '2017 to 2020' },
];
---

<Base
  title="About | Spencer Solomon"
  description="Spencer Solomon's background, web résumé and contact details."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(profile)} />
  <div class="wrap">
  <div class="page">
    <section class="bio">
      <h1>About</h1>
      <p>I'm a Staff Technical Project Manager at SentinelOne, based in Springfield, Missouri. Before that I spent nine years at Block, Jack Henry and Pondurance. My job has always been getting complicated technical work across the finish line: migrations, rollouts and projects that touch a dozen teams.</p>
      <p>In early 2026 that changed. With AI coding tools, mainly Claude Code, I started building the tools myself instead of only coordinating the people who build them. I'm not a traditional software engineer, and I don't pretend to be. What I'm good at is knowing what to build, directing the AI to build it, checking the work, and deciding when it's done or when to walk away.</p>
      <p>That shows up in the work here:</p>
      <ul>
        <li>At Block I built a knowledge base for support agents that went to production, plus the tools that kept a large content migration on track.</li>
        <li>On my own time I built an NBA prediction model that ran live for a season, and a real-time auction draft room for my fantasy football league.</li>
      </ul>
      <p>I'm looking for product, technical program or builder roles where I can do both: figure out the right thing to build, and build it. I'm especially interested in fintech, sports tech and internal tools.</p>
      <p>Outside of work, I'm an avid Chiefs fan. I play golf, travel with my wife, and take care of our two dogs, Zoey and Traeger.</p>
    </section>

    <section class="photos" aria-label="Photos">
      <Image class="ph ph-me" src={me} alt="Spencer Solomon in a navy cap, glasses and a red plaid jacket, standing in front of a large orange maple tree in autumn." widths={[640, 1000, 1640]} sizes="(min-width: 900px) 820px, 100vw" loading="eager" />
      <div class="pair">
        <Image class="ph" src={bridge} alt="The Golden Gate Bridge seen across the water from a hillside path, under a clear blue sky." widths={[400, 800]} sizes="(min-width: 900px) 400px, 50vw" />
        <Image class="ph" src={columns} alt="A long row of white marble columns beside a stone walkway, under a blue sky with streaky clouds." widths={[400, 800]} sizes="(min-width: 900px) 400px, 50vw" />
      </div>
    </section>

    <section id="resume" class="resume">
      <h2>Experience</h2>
      <ul class="roles">
        {roles.map(({ company, role, dates }) => (
          <li class="role">
            <span class="co">{company}</span>
            <span class="role-t"><strong>{role}</strong><span class="dates">{dates}</span></span>
          </li>
        ))}
      </ul>
      <p>PMP certified (2023).</p>
      <a class="btn primary" href="/resume.pdf">Résumé (PDF)</a>
    </section>

    <section id="contact" class="contact">
      <h2>Contact</h2>
      <p>The best way to reach me is email: <a class="mono email-link" href="mailto:spencerwsolomon@gmail.com">spencerwsolomon@gmail.com</a>. I'm also on <a href="https://www.linkedin.com/in/spencerwsolomon/">LinkedIn</a> and <a href="https://github.com/slickbets">GitHub</a>.</p>
      <a class="more" href="/resume.pdf">Résumé (PDF)</a>
    </section>
  </div>
  </div>
</Base>

<style>
  .page { max-width: 820px; padding-block: clamp(36px, 6vw, 72px) clamp(56px, 8vw, 104px); display: grid; gap: clamp(48px, 7vw, 80px); }

  section { display: grid; gap: 18px; }
  .resume, .contact { border-top: 1px solid var(--rule); padding-top: clamp(28px, 4vw, 40px); }
  h1 { font: 900 clamp(64px, 9vw, 140px)/.82 var(--disp); text-transform: uppercase; letter-spacing: -.005em; }
  h2 { font: 800 clamp(36px, 4vw, 56px)/.95 var(--disp); text-transform: uppercase; letter-spacing: .005em; }
  .bio p, .bio li { color: var(--muted-strong); }
  ul { margin: 0; padding-left: 22px; display: grid; gap: 10px; }
  li::marker { color: var(--accent); }
  section a:not(.more):not(.btn) { color: var(--accent); }
  strong { font-weight: 600; }

  .photos { gap: clamp(10px, 1.6vw, 16px); }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: inherit; }
  .ph { width: 100%; height: auto; border-radius: 18px; display: block; box-shadow: 0 24px 60px -28px rgb(var(--shadow) / .7); }
  .ph-me { aspect-ratio: 3 / 2; object-fit: cover; object-position: 50% 30%; }
  .pair .ph { aspect-ratio: 4 / 5; object-fit: cover; }

  /* Company on the left, role and years on the right, like a printed résumé. */
  .roles { list-style: none; padding: 0; border-top: 1px solid var(--rule); gap: 0; }
  .role { position: relative; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 6px 36px; padding-block: clamp(18px, 2.4vw, 28px); border-bottom: 1px solid var(--rule); }
  .co { font: 800 clamp(24px, 2.6vw, 36px)/.98 var(--disp); text-transform: uppercase; letter-spacing: .01em; }
  .role-t { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 20px; font: 600 18px/1.3 var(--sans); }
  .role-t strong { color: var(--fg); }
  .dates { font: 500 13px/1.3 var(--mono); color: var(--accent); white-space: nowrap; }
  @media (max-width: 640px) { .role { grid-template-columns: 1fr; } }

  .resume .btn { justify-self: start; }
  .mono { font-size: .94em; }
  .email-link { text-decoration: underline; text-underline-offset: 3px; }
</style>

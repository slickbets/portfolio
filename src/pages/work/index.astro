---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import StatusPill from '../../components/StatusPill.astro';

// Newest first. Projects from the same year keep their homepage order, then go alphabetically.
const projects = (await getCollection('projects')).sort(
  (a, b) =>
    b.data.year - a.data.year ||
    (a.data.featured ?? Infinity) - (b.data.featured ?? Infinity) ||
    a.data.title.localeCompare(b.data.title),
);
---

<Base title="Work | Spencer Solomon" description="Projects Spencer Solomon has built, from shipped work to personal experiments.">
  <div class="wrap page">
    <div class="intro">
      <h1>Work</h1>
      <p>These are the projects I've built, from a shipped tool at work to personal experiments.</p>
    </div>
    <ul class="list">
      {projects.map((project) => (
        <li class="card">
          <div class="visual"><ProjectVisual project={project} width={520} whole /></div>
          <div class="txt">
            <div class="meta"><StatusPill status={project.data.status} /></div>
            <h2><a href={`/work/${project.id}`}>{project.data.title}</a></h2>
            <p>{project.data.summary}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .page { padding-block: clamp(36px, 6vw, 72px) clamp(56px, 8vw, 104px); display: grid; gap: clamp(28px, 4vw, 44px); }
  .intro { display: grid; gap: 12px; }
  .intro p { color: var(--muted); font-size: clamp(17px, 1.6vw, 19px); max-width: 60ch; }
  h1 { font: 900 clamp(64px, 9vw, 140px)/.82 var(--disp); text-transform: uppercase; letter-spacing: -.005em; }

  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(20px, 3vw, 32px); }
  .card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 48px);
    align-items: center;
    padding: clamp(16px, 3vw, 28px);
    border: 1px solid var(--rule);
    border-radius: 22px;
    background: color-mix(in oklab, var(--bg-2) 55%, transparent);
    transition: border-color .3s, transform .5s var(--ease);
  }
  .card:hover { border-color: var(--accent); transform: translateY(-4px); }
  .visual { min-width: 0; }
  .txt { display: grid; gap: 14px; min-width: 0; }
  h2 { font: 800 clamp(28px, 3vw, 42px)/.98 var(--disp); text-transform: uppercase; letter-spacing: .005em; }
  h2 a { text-decoration: none; }
  /* The whole card is clickable through the title link. */
  h2 a::after { content: ''; position: absolute; inset: 0; border-radius: 22px; }
  .txt p { color: var(--muted); max-width: 56ch; }

  @media (max-width: 767px) {
    .card { grid-template-columns: 1fr; }
  }
</style>

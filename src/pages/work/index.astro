---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { orderedProjects } from '../../lib/projects';

// Newest first. Projects from the same year keep their homepage order.
const ordered = await orderedProjects();
const projects = ordered
  .map((item, i) => ({ ...item, i }))
  .sort((a, b) => b.project.data.year - a.project.data.year || a.i - b.i);
---

<Base title="Work | Spencer Solomon" description="Projects Spencer Solomon has built, from shipped work to personal experiments.">
  <section class="page-head wrap" aria-labelledby="work-title">
    <p class="kicker rv"><span class="dot" aria-hidden="true"></span>Work</p>
    <h1 class="rv" id="work-title">Work</h1>
    <p class="page-lede rv" style="--d:80ms">These are the projects I've built, from a shipped tool at work to personal experiments.</p>
  </section>
  <section class="work sheet work-list" aria-label="Projects">
    <div class="wrap">
      {projects.map(({ project, color }, n) => (
        <ProjectCard project={project} color={color} flip={n % 2 === 1} heading="h2" linkTitle proof={false} card={false} />
      ))}
    </div>
  </section>
</Base>

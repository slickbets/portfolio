---
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Arrow from '../../components/Arrow.astro';
import TeamRatings from '../../components/visuals/TeamRatings.astro';
import GameDetails from '../../components/visuals/GameDetails.astro';
import Accuracy from '../../components/visuals/Accuracy.astro';
import { orderedProjects, statusStyle } from '../../lib/projects';
import { caseStudySegments } from '../../lib/case-study';
import { HOLDING } from '../../lib/site';

export async function getStaticPaths() {
  if (HOLDING) return [];
  // Same order as the homepage, so "Next project" walks through the work and loops back.
  const ordered = await orderedProjects();
  return ordered.map(({ project, color }, i) => ({
    params: { slug: project.id },
    props: { project, color, next: ordered[(i + 1) % ordered.length] },
  }));
}

const { project, color, next } = Astro.props;
const { title, summary, status, type, year, stack, repo, demo, role, timeline, outcome, stats = [] } = project.data;
const brief = [['My role', role], ['Timeline', timeline], ['Outcome', outcome]].filter(([, v]) => v);

// Screenshots of these Slick Bets screens are placed as HTML tables built from the same values.
const visuals = { 'team-ratings.png': TeamRatings, 'game-details.png': GameDetails, 'model-accuracy.png': Accuracy };
const segments = await caseStudySegments(project.rendered?.html ?? '', project.id, visuals);
---

<Base title={`${title} | Spencer Solomon`} description={summary} image={`/og/${project.id}.png`} type="article" mainClass="case-main">
  <section class="case-head wrap" aria-labelledby="case-title">
    <a class="back rv" href="/work"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 10H4M9 4l-6 6 6 6"></path></svg>All work</a>
    <p class="meta rv"><span class={`status ${statusStyle(project)}`}>{status}</span><span>{type}, {year}</span></p>
    <h1 class="rv" id="case-title" style="--d:60ms">{title}</h1>
    <p class="case-sum rv" style="--d:120ms">{summary}</p>
  </section>
  <div class="wrap">
    <div class={`lead-vis lead-${color} rv`} style="--d:160ms"><ProjectVisual project={project} variant="lead" /></div>
  </div>
  <section class="sheet case-sheet">
    <div class="wrap">
      <div class="brief rv">
        <dl class="brief-main">
          {brief.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
        </dl>
        <dl class="brief-meta">
          <div><dt>Built with</dt><dd><ul class="tags">{stack.map((item) => <li>{item}</li>)}</ul></dd></div>
          {repo && <div><dt>Code</dt><dd><a class="more" href={repo}>GitHub repository <Arrow /></a></dd></div>}
          {demo && <div><dt>Demo</dt><dd><a class="more" href={demo}>Live site <Arrow /></a></dd></div>}
        </dl>
      </div>
      {stats.length > 0 && (
        <dl class={`stat-band stats-${stats.length} rv`}>
          {stats.map(({ value, label }) => <div><dd>{value}</dd><dt>{label}</dt></div>)}
        </dl>
      )}
      <article class="prose">
        {segments.map((segment) =>
          'html' in segment ? (
            <Fragment set:html={segment.html} />
          ) : (
            <figure class="fig fig-html rv">
              {(() => { const Visual = visuals[segment.visual as keyof typeof visuals]; return <Visual />; })()}
              {segment.caption && <figcaption set:html={segment.caption} />}
            </figure>
          ),
        )}
      </article>
      <a class={`next next-${next.color} rv`} href={`/work/${next.project.id}`}>
        <span class="next-label">Next project</span>
        <span class="next-title">{next.project.data.title}</span>
        <span class="next-arrow" aria-hidden="true"><Arrow /></span>
      </a>
    </div>
  </section>
  <ContactBlock heading="Get in touch" headingId="cta-title" page>
    If you're hiring for a product, program or builder role, email is the best way to reach me.
  </ContactBlock>
</Base>

---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import StatusPill from '../../components/StatusPill.astro';
import EmailCopy from '../../components/EmailCopy.astro';
import { themeAt } from '../../lib/themes';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  // Same order as the homepage, so "Next project" walks through the work and loops back.
  const ordered = projects.sort((a, b) => (a.data.featured ?? Infinity) - (b.data.featured ?? Infinity) || a.data.title.localeCompare(b.data.title));
  return ordered.map((project, i) => ({
    params: { slug: project.id },
    // Each project page wears its project's colors, the same ones as its card on the homepage wheel.
    props: { project, next: ordered[(i + 1) % ordered.length], theme: themeAt(i, project.data.theme) },
  }));
}

const { project, next, theme } = Astro.props;
const { title, summary, status, type, year, stack, repo, demo } = project.data;
const { Content } = await render(project);
---

<Base title={`${title} | Spencer Solomon`} description={summary} image={`/og/${project.id}.png`} type="article" theme={theme}>
  <div class="wrap case">
    <header class="head">
      <a class="back" href="/work">← All work</a>
      <h1>{title}</h1>
      <p class="sum">{summary}</p>
      <dl class="facts">
        <div><dt>Status</dt><dd><StatusPill status={status} /></dd></div>
        <div><dt>Type</dt><dd>{type}, {year}</dd></div>
        <div>
          <dt>Built with</dt>
          <dd><ul class="chips">{stack.map((item) => <li>{item}</li>)}</ul></dd>
        </div>
        {repo && <div><dt>Code</dt><dd><a href={repo}>GitHub repository</a></dd></div>}
        {demo && <div><dt>Demo</dt><dd><a href={demo}>Live site</a></dd></div>}
      </dl>
    </header>

    <ProjectVisual project={project} width={1100} whole priority showStats />

    <article class="article">
      <Content />
    </article>

    <section class="end">
      {next.id !== project.id && (
        <a class="next" href={`/work/${next.id}`}>
          <span class="next-label">Next project →</span>
          <span class="next-title">{next.data.title}</span>
        </a>
      )}
      <div class="cta">
        <h2>Get in touch</h2>
        <p>If you're hiring for a product, program or builder role, email is the best way to reach me.</p>
        <EmailCopy />
        <div class="btns">
          <a class="btn primary" href="/resume.pdf">Résumé (PDF)</a>
          <a class="btn" href="https://www.linkedin.com/in/spencerwsolomon/">LinkedIn</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .head { padding-block: clamp(36px, 6vw, 72px) 28px; display: grid; gap: 18px; max-width: 880px; }
  .back { font: 500 14px/1 var(--mono); color: var(--muted); text-decoration: none; justify-self: start; padding-block: 10px; }
  .back:hover { color: var(--accent); }
  h1 { font: 900 clamp(48px, 7vw, 104px)/.88 var(--disp); text-transform: uppercase; letter-spacing: -.005em; max-width: 18ch; }
  .sum { font-size: clamp(18px, 1.8vw, 21px); color: var(--muted); max-width: 60ch; }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 18px 32px;
    border-top: 1px solid var(--rule);
    padding-top: 20px;
    margin: 6px 0 0;
  }
  .facts div { display: grid; gap: 6px; align-content: start; min-width: 0; }
  .facts dt { font: 500 12px/1 var(--mono); text-transform: uppercase; letter-spacing: .12em; color: var(--muted); }
  .facts dd { margin: 0; font: 500 15px/1.45 var(--sans); }
  .facts a { color: var(--accent); }

  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chips li { font: 400 12.5px/1 var(--mono); padding: 6px 9px; border-radius: 999px; background: var(--tint); border: 1px solid var(--rule); }

  .end { border-top: 1px solid var(--rule); padding-block: clamp(36px, 6vw, 64px) clamp(56px, 8vw, 96px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(20px, 4vw, 48px); align-items: start; }
  .next { display: grid; gap: 10px; padding: clamp(18px, 3vw, 28px); border: 1px solid var(--rule); border-radius: 22px; text-decoration: none; background: var(--tint); transition: border-color .3s, transform .5s var(--ease); }
  .next:hover { border-color: var(--accent); transform: translateY(-3px); }
  .next-label { font: 600 14px/1 var(--mono); color: var(--accent); }
  .next-title { font: 800 clamp(24px, 2.6vw, 34px)/.98 var(--disp); text-transform: uppercase; }
  .cta { display: grid; gap: 16px; justify-items: start; }
  .cta h2 { font: 800 clamp(30px, 3.4vw, 46px)/.95 var(--disp); text-transform: uppercase; }
  .cta p { color: var(--muted); max-width: 52ch; }
  @media (max-width: 767px) { .end { grid-template-columns: 1fr; } }

  .article :global(.callout) { margin: 14px 0; padding: clamp(18px, 3vw, 28px); border-radius: 14px; background: var(--tint); border: 1px solid var(--rule); border-left: 3px solid var(--accent); display: grid; gap: 14px; }
  .article :global(.callout-label) { font: 500 13px/1 var(--mono); color: var(--muted-strong); }
  .article :global(.callout-stats) { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 18px; }
  .article :global(.callout-stats div) { display: grid; gap: 4px; }
  .article :global(.callout-stats strong) { font: 600 30px/1.1 var(--sans); color: var(--accent); letter-spacing: -.02em; }
  .article :global(.callout-stats span) { font-size: 15px; line-height: 1.45; color: var(--muted-strong); }

  .article { max-width: 680px; padding-block: 36px 56px; display: grid; gap: 18px; }
  .article :global(h2) { font: 800 clamp(30px, 3vw, 40px)/.98 var(--disp); text-transform: uppercase; letter-spacing: .005em; margin-top: 26px; }
  .article :global(p), .article :global(ul) { margin: 0; }
  .article :global(ul) { padding-left: 22px; display: grid; gap: 10px; }
  .article :global(li::marker) { color: var(--accent); }
  .article :global(strong) { font-weight: 600; }
  .article :global(a) { color: var(--accent); }
</style>

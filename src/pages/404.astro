---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Spencer Solomon" description="This page doesn't exist on spencerwsolomon.com." noindex>
  <div class="wrap">
    <section class="notfound">
      <h1>That page doesn't exist.</h1>
      <p>The link may be old, or the address may have a typo. You can head back home or look through my work instead.</p>
      <div class="btns">
        <a class="btn primary" href="/">Go to the homepage</a>
        <a class="btn" href="/work">See my work</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .notfound { padding-block: clamp(56px, 10vw, 128px); display: grid; gap: 22px; justify-items: start; }
  h1 { font: 900 var(--tdisp)/.86 var(--disp); text-transform: uppercase; letter-spacing: -.005em; }
  p { color: var(--muted); font-size: var(--t22); line-height: 1.4; max-width: 44ch; text-wrap: pretty; }
  @media (max-width: 760px) { p { font-size: var(--t18); line-height: 1.55; } }
</style>

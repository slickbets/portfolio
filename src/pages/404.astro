---
import Base from '../layouts/Base.astro';
import { HOLDING } from '../lib/site';
---

<Base title="Page not found | Spencer Solomon" description="This page doesn't exist on spencerwsolomon.com." noindex mainClass="nf-main">
  <section class="nf wrap" aria-labelledby="nf-title">
    <p class="nf-code rv" aria-hidden="true">4<span class="pill pill-code"><i></i><i></i><i></i></span>4</p>
    <h1 class="rv" id="nf-title" style="--d:60ms">That page doesn't exist.</h1>
    <p class="page-lede rv" style="--d:120ms">The link may be old, or the address may have a typo. You can head back home{!HOLDING && ' or look through my work instead'}.</p>
    <div class="btns rv" style="--d:180ms">
      <a class="btn btn-ink" href="/">Go to the homepage</a>
      {!HOLDING && <a class="btn btn-soft" href="/work">See my work</a>}
    </div>
  </section>
</Base>

---
// Temporary review page for the design system. Remove it before launch.
import Base from '../layouts/Base.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import StatusPill from '../components/StatusPill.astro';
import tvBoard from '../../content/screenshots/auction-draft/tv-board.png';
import managerPhone from '../../content/screenshots/auction-draft/manager-going-once.png';

const colors = [
  { name: '--bg', hex: '#fafaf9', use: 'Page background' },
  { name: '--tint', hex: '#f2f3f1', use: 'Alternate sections and chips' },
  { name: '--fg', hex: '#18191b', use: 'Body text' },
  { name: '--muted', hex: '#5b5f66', use: 'Secondary text' },
  { name: '--rule', hex: '#e4e5e2', use: 'Borders and dividers' },
  { name: '--accent', hex: '#2148b8', use: 'Navy, the one accent' },
  { name: '--accent-ink', hex: '#fafaf9', use: 'Text on the accent' },
  { name: '--frame', hex: '#1d1f22', use: 'Phone bezel only' },
  { name: '--chrome', hex: '#ececea', use: 'Browser title bar' },
  { name: '--dot', hex: '#cfd0cc', use: 'Browser window dots' },
];

const statuses = ['Live', 'Shipped', 'Prototype', 'Concept', 'Retired'] as const;
---

<Base title="Styleguide | Spencer Solomon" description="Temporary page for reviewing the site's design system.">
  <div class="wrap sg">
    <header class="intro">
      <h1>Styleguide</h1>
      <p>This page is temporary. It shows the pieces of the Workbench design so they can be checked against the reference page, and it will be removed before launch.</p>
    </header>

    <section>
      <h2>Colors</h2>
      <ul class="swatches">
        {colors.map((c) => (
          <li>
            <span class="chip" style={`background: var(${c.name})`}></span>
            <span class="label">{c.name}</span>
            <span class="caption">{c.hex}</span>
            <span class="use">{c.use}</span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Type</h2>
      <div class="type">
        <div><span class="caption">Hero heading, 36 to 58px, 600</span><p class="t-hero">I'm Spencer. I build software by directing AI, <em>and I ship it.</em></p></div>
        <div><span class="caption">Project page title, 32 to 52px, 600</span><p class="t-case">Slick Bets, an NBA prediction model</p></div>
        <div><span class="caption">Contact heading, 30 to 46px, 600</span><p class="t-contact">Hiring for a product, program or builder role?</p></div>
        <div><span class="caption">Project row title, 26 to 36px, 600</span><p class="t-row">A live auction draft room for my fantasy league</p></div>
        <div><span class="caption">Article heading, 26px, 600</span><p class="t-article">What I learned</p></div>
        <div><span class="caption">Proof line, 20 to 24px, 600</span><p class="t-proof">71.5% of winners picked correctly<small>648 games, each prediction locked in before tip-off</small></p></div>
        <div><span class="caption">Lead text, 18 to 20px, muted</span><p class="t-lead">A technical program manager who builds working software with Claude Code and makes the product calls along the way.</p></div>
        <div><span class="caption">Body text, 17px, line height 1.6</span><p class="t-body">I directed Claude Code through every part of it over about ten weeks. I set the goals, made the calls on the model and the product, and reviewed everything before it shipped.</p></div>
        <div><span class="caption">Meta text, 14px, 500, muted</span><p class="t-meta">Personal, 2026</p></div>
        <div><span class="caption">Email, Geist Mono, 20 to 26px</span><p class="t-email">spencerwsolomon@gmail.com</p></div>
      </div>
    </section>

    <section>
      <h2>Buttons</h2>
      <div class="btns">
        <a class="btn primary" href="#buttons">See my work</a>
        <a class="btn" href="#buttons" id="buttons">Résumé</a>
      </div>
    </section>

    <section>
      <h2>Status pills</h2>
      <div class="pills">
        {statuses.map((s) => <StatusPill status={s} />)}
      </div>
    </section>

    <section>
      <h2>Frames</h2>
      <div class="frames">
        <BrowserFrame src={tvBoard} width={820} alt="Draft room TV board showing every team's budget, the nomination clock and recent sales" />
        <PhoneFrame src={managerPhone} position="6% top" width={240} alt="A manager's view of the draft room while a player is going once" />
      </div>
    </section>
  </div>
</Base>

<style>
  .sg { padding-block: clamp(32px, 6vw, 72px) clamp(56px, 8vw, 104px); display: grid; gap: clamp(48px, 7vw, 80px); }
  .intro { display: grid; gap: 14px; max-width: 64ch; }
  .intro h1 { font-size: clamp(32px, 4.4vw, 52px); line-height: 1.06; }
  .intro p { color: var(--muted); }
  section { display: grid; gap: 24px; border-top: 1px solid var(--rule); padding-top: 28px; }
  section h2 { font-size: 26px; }

  .caption, .label { font: 400 13px/1.4 var(--mono); color: var(--muted); }
  .label { color: var(--fg); }

  .swatches { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 24px; }
  .swatches li { display: grid; gap: 4px; }
  .chip { display: block; height: 72px; border-radius: 14px; border: 1px solid var(--rule); margin-bottom: 8px; }
  .use { font-size: 14px; color: var(--muted); }

  .type { display: grid; gap: 28px; }
  .type > div { display: grid; gap: 6px; }
  .t-hero { font-size: clamp(36px, 4.6vw, 58px); line-height: 1.04; font-weight: 600; letter-spacing: -.025em; text-wrap: balance; max-width: 18ch; }
  .t-hero em { font-style: normal; color: var(--accent); }
  .t-case { font-size: clamp(32px, 4.4vw, 52px); line-height: 1.06; font-weight: 600; letter-spacing: -.025em; }
  .t-contact { font-size: clamp(30px, 3.8vw, 46px); line-height: 1.08; font-weight: 600; letter-spacing: -.025em; max-width: 18ch; }
  .t-row { font-size: clamp(26px, 3vw, 36px); line-height: 1.1; font-weight: 600; letter-spacing: -.025em; }
  .t-article { font-size: 26px; font-weight: 600; letter-spacing: -.025em; }
  .t-proof { font: 600 clamp(20px, 2vw, 24px)/1.3 var(--sans); letter-spacing: -.01em; }
  .t-proof small { display: block; font: 400 15px/1.4 var(--sans); color: var(--muted); letter-spacing: 0; margin-top: 2px; }
  .t-lead { font-size: clamp(18px, 1.6vw, 20px); color: var(--muted); max-width: 40ch; }
  .t-body { max-width: 64ch; }
  .t-meta { font: 500 14px/1 var(--sans); color: var(--muted); }
  .t-email { font: 500 clamp(20px, 2.4vw, 26px)/1.2 var(--mono); word-break: break-word; }

  .pills { display: flex; flex-wrap: wrap; gap: 10px; }

  .frames { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 240px); gap: clamp(24px, 5vw, 56px); align-items: start; }

  @media (max-width: 767px) {
    .frames { grid-template-columns: 1fr; }
    .frames :global(.phone) { width: min(60%, 240px); }
  }
</style>

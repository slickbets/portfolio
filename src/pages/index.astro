---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectWheel from '../components/ProjectWheel.astro';
import EmailCopy from '../components/EmailCopy.astro';
import me from '../assets/about/me.jpg';
import bridge from '../assets/about/golden-gate.jpg';
import columns from '../assets/about/athens.jpg';
import '../styles/home.css';

const projects = await getCollection('projects');
const featured = projects.filter(({ data }) => data.featured !== undefined).sort((a, b) => a.data.featured! - b.data.featured!);

// The strip under the headline lists every tool in a project's stack, most-used first.
const counts = new Map<string, number>();
for (const { data } of projects) for (const item of data.stack) counts.set(item, (counts.get(item) ?? 0) + 1);
const stack = [...counts.entries()].sort((a, b) => b[1] - a[1]).map(([name]) => name);

// Tells search engines who this site is about, so a search for the name can show a profile.
// Short chapters from the About page, each beside one of Spencer's own photos.
const chapters = [
  { n: '01', label: 'The day job', rot: '-2.5deg', photo: me, alt: 'Spencer Solomon in a navy cap, glasses and a red plaid jacket, standing in front of a large orange maple tree in autumn.', text: "I'm a Staff Technical Project Manager at SentinelOne, based in Springfield, Missouri. My job has always been getting complicated technical work across the finish line: migrations, rollouts and projects that touch a dozen teams." },
  { n: '02', label: 'Early 2026', rot: '2deg', photo: bridge, alt: 'The Golden Gate Bridge seen across the water from a hillside path, under a clear blue sky.', text: 'In early 2026 that changed. With AI coding tools, mainly Claude Code, I started building the tools myself instead of only coordinating the people who build them.' },
  { n: '03', label: 'Off the clock', rot: '-1.5deg', photo: columns, alt: 'A long row of white marble columns beside a stone walkway, under a blue sky with streaky clouds.', text: "Outside of work, I'm an avid Chiefs fan. I play golf, travel with my wife, and take care of our two dogs, Zoey and Traeger." },
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  // Same @id as the Person on /about, so search engines treat both blocks as one person.
  '@id': 'https://spencerwsolomon.com/#person',
  name: 'Spencer Solomon',
  url: 'https://spencerwsolomon.com/',
  jobTitle: 'Staff Technical Project Manager',
  worksFor: { '@type': 'Organization', name: 'SentinelOne' },
  email: 'mailto:spencerwsolomon@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Springfield', addressRegion: 'MO', addressCountry: 'US' },
  sameAs: ['https://www.linkedin.com/in/spencerwsolomon/', 'https://github.com/slickbets'],
};
---

<Base
  title="Spencer Solomon | building w/ AI tools"
  description="Work tools and personal products I built with AI and put in front of real users."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />

  <!-- Hero: the headline rises in letter by letter once the fonts are ready (see src/scripts/wheel.js). -->
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-type">
      <h1 class="headline" id="hero-title">
        <span class="sr-only">Built with AI. Shipped to real users.</span>
        <span class="line l1" aria-hidden="true" data-split>Built with AI.</span>
        <span class="line l2" aria-hidden="true" data-split>Shipped to</span>
        <span class="line l3" aria-hidden="true"><em>real users.</em><svg class="swoosh" viewBox="0 0 400 30"><path d="M6 21 C 110 8, 250 4, 394 15" pathLength="1"></path></svg></span>
      </h1>
      <div class="hero-foot">
        <p>Work tools and personal products I built with AI and put in front of real users.</p>
        <div class="btns">
          <a class="btn primary" href="#work">See my work <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v13M4 10l6 6 6-6"></path></svg></a>
          <a class="btn" href="/resume.pdf">Résumé (PDF)</a>
        </div>
      </div>
    </div>
  </section>

  <div class="strip-bleed">
    <div class="strip" aria-hidden="true">
      <div class="strip-track">
        {[0, 1].map(() => stack.map((name) => <><span>{name}</span><i></i></>))}
      </div>
    </div>
  </div>

  <ProjectWheel projects={featured} />

  <section class="about wrap" id="about" aria-labelledby="about-title">
    <div class="about-l">
      <p class="kicker rv"><span class="kicker-dot" aria-hidden="true"></span>About</p>
      <h2 class="about-title rv" id="about-title">I'm Spencer. I&nbsp;build software by directing AI, and&nbsp;I <em>ship&nbsp;it.</em></h2>
      <a class="more rv" href="/about">More about me <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M11 4l6 6-6 6"></path></svg></a>
    </div>
    <div class="chapters">
      {chapters.map(({ n, label, rot, photo, alt, text }) => (
        <figure class="chapter rv" style={`--rot:${rot}`}>
          <div class="photo"><Image src={photo} alt={alt} widths={[360, 640]} sizes="(min-width: 1000px) 420px, 62vw" /></div>
          <figcaption>
            <span class="ch-label"><b>{n}</b>{label}</span>
            <p>{text}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="contact wrap" id="contact">
    <div class="contact-card rv">
      <div>
        <p class="kicker kicker-ink"><span class="kicker-dot" aria-hidden="true"></span>Contact</p>
        <h2>Hiring for a product, program or builder role?</h2>
        <p>I want a role where I decide what to build and then build it, in fintech, sports tech or internal tools. I'm in Springfield, MO and open to remote. Email is the fastest way to reach me.</p>
      </div>
      <div class="contact-r">
        <EmailCopy />
        <div class="btns">
          <a class="btn btn-ink" href="/resume.pdf">Résumé (PDF)</a>
          <a class="btn btn-line" href="https://www.linkedin.com/in/spencerwsolomon/">LinkedIn</a>
          <a class="btn btn-line" href="https://github.com/slickbets">GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/wheel.js';
</script>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Diagram from '../components/Diagram.astro';
import ProjectRow from '../components/ProjectRow.astro';

const featured = (await getCollection('projects', ({ data }) => data.featured !== undefined)).sort(
  (a, b) => a.data.featured! - b.data.featured!,
);
const hub = featured.find((p) => p.id === 'support-content-hub');
const layouts = ['stacked', 'tint', 'flip'] as const;

// Tells search engines who this site is about, so a search for the name can show a profile.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Spencer Solomon',
  url: 'https://spencerwsolomon.com/',
  jobTitle: 'Technical Program Manager',
  email: 'mailto:spencerwsolomon@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Springfield', addressRegion: 'MO', addressCountry: 'US' },
  sameAs: ['https://www.linkedin.com/in/spencerwsolomon/', 'https://github.com/slickbets'],
};
---

<Base
  title="Spencer Solomon | building w/ AI tools"
  description="A technical program manager who builds working software with Claude Code and makes the product calls along the way."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <div class="wrap">
    <section class="hero">
      <div class="txt">
        <h1 style="--i: 0">I'm Spencer. I build software by directing AI, <em>and I ship it.</em></h1>
        <p style="--i: 1">A technical program manager who builds working software with Claude Code and makes the product calls along the way.</p>
        <div class="btns" style="--i: 2">
          <a class="btn primary" href="/work">See my work</a>
          <a class="btn" href="/about#resume">Résumé</a>
        </div>
      </div>
      <a class="hero-visual" href="/work/support-content-hub" aria-label="Read the case study: moving a fintech's support content off Zendesk">
        <span class="hero-tag"><span class="dot" aria-hidden="true"></span>Shipped: an agent knowledge base in production</span>
        <Diagram stats={hub?.data.stats} caption="Confidential work for a leading fintech, shown as a diagram." />
      </a>
    </section>
  </div>

  {featured.map((project, i) => <ProjectRow project={project} layout={layouts[i % layouts.length]} />)}

  <section class="contact">
    <div class="wrap">
      <h2>Hiring for a product, program or builder role?</h2>
      <p>I'm looking for work where I can figure out the right thing to build and then build it, especially in internal tools, customer-facing products, sports tech and weather. Email is the best way to reach me.</p>
      <a class="email" href="mailto:spencerwsolomon@gmail.com">spencerwsolomon@gmail.com</a>
      <div class="btns">
        <a class="btn" href="https://www.linkedin.com/in/spencerwsolomon/">LinkedIn</a>
        <a class="btn" href="https://github.com/slickbets">GitHub</a>
        <a class="btn" href="/about#resume">Résumé</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(32px, 6vw, 80px) clamp(48px, 7vw, 96px);
  }
  .txt { display: grid; gap: 22px; }
  h1 { font-size: clamp(36px, 4.6vw, 58px); line-height: 1.04; }
  h1 em { font-style: normal; color: var(--accent); }
  .txt p { color: var(--muted); font-size: clamp(18px, 1.6vw, 20px); max-width: 40ch; }

  /* Hero visual: the shipped Zendesk work, with its stat row. */
  .hero-visual { display: grid; gap: 12px; text-decoration: none; color: inherit; min-width: 0; }
  .hero-visual :global(.diagram) { box-shadow: 0 30px 60px -32px rgb(var(--shadow) / .35); background: var(--bg); }
  .hero-visual:hover :global(.diagram) { border-color: var(--accent); }
  .hero-tag { justify-self: start; display: inline-flex; gap: 8px; align-items: center; font: 500 13px/1 var(--mono); padding: 7px 12px; border-radius: 999px; border: 1px solid var(--rule); background: var(--bg); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    .hero-visual { animation: rise 1s var(--ease) .15s both; }
  }

  .contact { border-top: 1px solid var(--rule); }
  .contact .wrap { padding-block: clamp(56px, 8vw, 104px); display: grid; gap: 18px; justify-items: start; }
  .contact h2 { font-size: clamp(30px, 3.8vw, 46px); line-height: 1.08; max-width: 18ch; }
  .contact p { color: var(--muted); max-width: 56ch; }
  .email {
    font: 500 clamp(20px, 2.4vw, 26px)/1.2 var(--mono);
    color: var(--fg);
    text-decoration: none;
    word-break: break-word;
    padding-block: 4px;
  }

  @media (max-width: 767px) {
    .hero { grid-template-columns: 1fr; padding-top: 24px; }
  }
</style>

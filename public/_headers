# Cloudflare reads this file. Files in /_astro/ have a content hash in their name, so a changed
# file always gets a new URL. That makes it safe to let browsers keep them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Redesign mockups are preview-only. Keep them out of search results.
/redesign/*
  X-Robots-Tag: noindex
